# Copy to .env and fill in. Never commit the filled-in file.

# ---- Application ----
NODE_ENV=development
# The API listens here. Next.js owns 3000, so the API uses 3001.
PORT=3001
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=car_rental

# ---- Auth ----
# Generate one with: openssl rand -base64 32
# The app refuses to start in production if this is left at the default.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=1d
